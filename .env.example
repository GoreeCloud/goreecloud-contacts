# GoreeCloud Contacts example configuration
#
# Copy this file to .env for local development. Never commit .env.

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# CardDAV service endpoint. User credentials are entered at application sign-in
# and are not stored in this file or source control.
# Example server URL: https://calendar.example.com
CARDDAV_BASE_URL=
CARDDAV_TIMEOUT_SECONDS=15

# Write operations are disabled by default. Enable this only in an approved
# environment after confirming that the authenticated account and discovered
# address book are safe for controlled write testing or production use.
CARDDAV_WRITE_ENABLED=false

# Opaque server-side session settings. The browser cookie contains only a random
# session token. CardDAV credentials remain in backend process memory and expire
# with the session or when the backend restarts.
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_NAME=goreecloud_contacts_session
SESSION_COOKIE_SECURE=false

# Browser origin used by the local frontend.
FRONTEND_ORIGIN=http://localhost:5173
