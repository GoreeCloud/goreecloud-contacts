# GoreeCloud Contacts example configuration
#
# Copy this file to .env for local development or create a protected production .env.
# Never commit an active .env or reusable secret.

# Accepted values are development, test, or production. Unknown/typo values fail
# configuration validation instead of silently bypassing production safeguards.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# CardDAV service endpoint. User credentials are entered at application sign-in
# and are not stored in this file or source control.
# Planned GoreeCloud Radicale identity: https://dav.goreecloud.com
# calendar.goreecloud.com is being reserved for the GoreeCloud Calendar application.
CARDDAV_BASE_URL=
CARDDAV_TIMEOUT_SECONDS=15

# Ordinary contact/VCF writes are disabled by default. Enable this only after the
# selected target environment has passed backup, restore, authentication, and
# production-representative acceptance checks.
CARDDAV_WRITE_ENABLED=false

# Duplicate merging has its own stabilization gate because Phase 4C isolated live
# acceptance is still outstanding. Keep this false for the initial stable publication
# even if ordinary CardDAV writes are approved later.
DUPLICATE_MERGE_ENABLED=false

# Opaque server-side session settings. The browser cookie contains only a random
# token. The development default keeps CardDAV credentials only in process memory.
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_NAME=goreecloud_contacts_session
SESSION_COOKIE_SECURE=false
SESSION_STORE_BACKEND=memory

# Shared production session storage. Production requires the sqlite backend.
# Browser tokens are stored only as SHA-256 digests, while CardDAV credentials are
# encrypted before SQLite persistence. The database path must live on a protected
# persistent application-data mount.
SESSION_DB_PATH=/data/sessions.sqlite3

# Production encryption-key delivery supports two mutually exclusive forms.
# Prefer SESSION_ENCRYPTION_KEYS_FILE for production. The production Compose model
# mounts the host-side protected secret at /run/secrets/session-encryption-keys.
# SESSION_ENCRYPTION_KEYS remains available for local/test environments and legacy
# deployments, but active production key material should not normally live directly
# in the ordinary .env when a file-based secret is supported.
SESSION_ENCRYPTION_KEYS=
SESSION_ENCRYPTION_KEYS_FILE=

# Browser origin used by the frontend. This must be an origin only: scheme,
# hostname, and optional port, with no path/query/fragment.
FRONTEND_ORIGIN=http://localhost:5173

# Browser mutation CSRF protection. When enabled, POST/PUT/PATCH/DELETE requests
# must carry a matching Origin header or a matching Referer fallback.
# Production configuration fails closed unless this and SESSION_COOKIE_SECURE are true.
CSRF_ORIGIN_CHECK_ENABLED=false

# Docker Compose deployment metadata. These values are consumed by the production
# Compose model and ignored by the application settings layer.
GOREECLOUD_CONTACTS_DATA_PATH=/srv/docker/appdata/goreecloud-contacts
GOREECLOUD_CONTACTS_SESSION_SECRET_PATH=/srv/docker/secrets/goreecloud-contacts/session-encryption-keys
GOREECLOUD_CONTACTS_IMAGE_TAG=local

# Production attaches Contacts to the shared proxy network with an explicit address.
# The selected address must be verified free on the target network before deployment
# and then used as the least-privilege source identity for CardDAV access through Caddy.
# Current goreecloud-vps-01 validated candidate: 172.19.0.51 on proxy 172.19.0.0/16.
GOREECLOUD_CONTACTS_PROXY_IP=172.19.0.51

# The production container preserves the HTTPS CardDAV hostname while routing that
# hostname to Caddy's private proxy-network address. Keep this hostname aligned with
# CARDDAV_BASE_URL and revalidate it whenever the Radicale service identity changes.
# Planned production identity after the Radicale migration: dav.goreecloud.com.
GOREECLOUD_CONTACTS_CARDDAV_HOST=

# Target-specific private Caddy address used only for the CardDAV hostname mapping.
# Inspect the selected host rather than assuming this value. Current validated
# goreecloud-vps-01 Caddy proxy address: 172.19.0.2.
GOREECLOUD_CONTACTS_CADDY_IP=

# FastAPI Swagger UI, ReDoc, and OpenAPI schema routes remain available for
# development/test use and are removed automatically when APP_ENV=production.
# There is intentionally no production override that re-enables them.

# Production example — values must be reviewed against current target-host state:
# APP_ENV=production
# FRONTEND_ORIGIN=https://contacts.goreecloud.com
# CARDDAV_BASE_URL=https://dav.goreecloud.com
# CARDDAV_WRITE_ENABLED=false
# DUPLICATE_MERGE_ENABLED=false
# SESSION_COOKIE_SECURE=true
# CSRF_ORIGIN_CHECK_ENABLED=true
# SESSION_STORE_BACKEND=sqlite
# SESSION_DB_PATH=/data/sessions.sqlite3
# SESSION_ENCRYPTION_KEYS_FILE=/run/secrets/session-encryption-keys
# GOREECLOUD_CONTACTS_SESSION_SECRET_PATH=/srv/docker/secrets/goreecloud-contacts/session-encryption-keys
# GOREECLOUD_CONTACTS_PROXY_IP=172.19.0.51
# GOREECLOUD_CONTACTS_CARDDAV_HOST=dav.goreecloud.com
# GOREECLOUD_CONTACTS_CADDY_IP=172.19.0.2
