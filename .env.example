# GoreeCloud Contacts example configuration
#
# Copy this file to .env for local development and replace placeholders only
# with approved development values. Never commit the resulting .env file.

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# CardDAV test endpoint. Use a non-production test account/address book during development.
CARDDAV_BASE_URL=https://calendar.example.com
CARDDAV_USERNAME=development-user
CARDDAV_PASSWORD=replace-with-protected-development-secret

# Application session secret. Generate a unique development value outside source control.
SESSION_SECRET=replace-with-random-development-secret

# Browser origin used by the local frontend.
FRONTEND_ORIGIN=http://localhost:5173
