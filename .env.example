# GoreeCloud Contacts example configuration
#
# Copy this file to .env for local development. Keep the CardDAV values blank
# until you are ready to use an approved test account. Never commit .env.

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CARDDAV_TIMEOUT_SECONDS=15

# CardDAV test configuration.
# Example server URL: https://calendar.example.com
CARDDAV_BASE_URL=
CARDDAV_ADDRESSBOOK_HOME_URL=
CARDDAV_USERNAME=
CARDDAV_PASSWORD=

# Write operations are disabled by default. Enable this only in an approved
# environment after confirming that the configured account and address book
# are safe for controlled write testing or production use.
CARDDAV_WRITE_ENABLED=false

# Reserved for the future authenticated application session layer.
SESSION_SECRET=

# Browser origin used by the local frontend.
FRONTEND_ORIGIN=http://localhost:5173
